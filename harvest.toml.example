# Harvest battery for the local gateway. Copy to harvest.toml and edit.
#
# Pacing: 6 seconds between requests, 120 per run. Four working families at 300
# samples is 1200 requests, roughly two hours of wall clock spread over as many
# days as you like. The corpus is append-only and every start skips what it
# already has, so interrupting a run costs nothing and cron is safe.
#
# `family` is the catalog label. Versions and reasoning-effort variants collapse
# into one family until the eval shows they actually separate.
#
# Model ids are chosen so the endpoint reports a SPECIFIC upstream. Several
# aliases answer with "gemini-default" or "gemini-pro-default", which cannot be
# audited later, so they make poor catalog labels even though they work.
# Verified working 2026-07-28.

base_url = "http://127.0.0.1:20128/v1"
api_key = ""
delay_secs = 6.0
per_run = 120
strikes = 3

[[models]]
family = "claude-4"
provider = "anthropic"
model = "ag/claude-sonnet-4-6"   # upstream reports claude-sonnet-4-6
target = 300

[[models]]
family = "gemini-3"
provider = "google"
model = "ag/gemini-3-flash"      # upstream reports gemini-3-flash
target = 300

[[models]]
family = "gpt-oss"
provider = "openweight"
model = "ag/gpt-oss-120b-medium" # upstream reports gpt-oss-120b-medium
target = 300

# The free flash tier, not the flagship. It returns empty bodies often enough
# that `strikes` will retire it early on a bad day, which is fine, the next run
# picks up where this one stopped.
[[models]]
family = "deepseek-flash"
provider = "deepseek"
model = "OpenCodeDeepSeek"       # upstream reports deepseek-v4-flash-free
target = 300

