# Harvest battery for the local gateway. Copy to harvest.toml and edit.
#
# Pacing: 6 seconds between requests, and a 429 is waited out rather than
# counted as a failure, because the gateway rate limits under sustained load.
# The corpus is append-only and every start skips what it already has, so
# interrupting a run costs nothing and cron is safe. Raise per_run for a long
# unattended pass.
#
# `family` is the catalog label. Versions and reasoning-effort variants
# collapse into one family until the eval shows they actually separate.
#
# Model ids are picked so the endpoint reports a SPECIFIC upstream. Several
# aliases answer as "gemini-default", which cannot be audited later.
# Verified working 2026-07-28.
#
# `provider` is the SERVING path, not the model's author. The nvidia entries
# below are third-party models on NVIDIA's hosted inference, so a fingerprint
# mined from them is that model as NVIDIA serves it. Sampling defaults, an
# injected system prompt or quantisation can all differ from the same weights
# served by the lab that made them, and the catalog cannot tell the difference.
#
# Provenance is also weaker here than it looks. For cx/* the gateway leaked a
# real upstream path in an error (codex/gpt-5.4-mini), whereas the nvidia
# entries just echo the alias back with the prefix stripped, which is not
# independent evidence of what ran. Treat those labels as claims, not receipts.

base_url = "http://127.0.0.1:20128/v1"
api_key = ""
delay_secs = 6.0
per_run = 120
strikes = 3
backoff_secs = 60.0

[[models]]
family = "claude-4"
provider = "anthropic"
model = "ag/claude-sonnet-4-6"
target = 300

[[models]]
family = "gemini-3"
provider = "google"
model = "ag/gemini-3-flash"
target = 300

[[models]]
family = "gpt-5"
provider = "openai"
model = "cx/gpt-5.6-sol"
target = 300

[[models]]
family = "deepseek-v4"
provider = "nvidia"          # NVIDIA-hosted, model authored by DeepSeek
model = "nvidia/deepseek-ai/deepseek-v4-pro"
target = 300

[[models]]
family = "glm"
provider = "nvidia"          # NVIDIA-hosted, model authored by Zhipu (Z.ai)
model = "nvidia/z-ai/glm-5.2"
target = 300

[[models]]
family = "minimax"
provider = "nvidia"          # NVIDIA-hosted, model authored by MiniMax
model = "nvidia/minimaxai/minimax-m3"
target = 300

[[models]]
family = "gpt-oss"
provider = "openweight"
model = "ag/gpt-oss-120b-medium"
target = 300

# Not a catalog family. This is the SAME model the 2024 reference corpus used,
# so harvesting it here and asking a classifier to separate our samples from
# theirs measures whether our harvest is comparable to theirs at all. If it can
# tell them apart, harvest parameters carry their own fingerprint and every
# cross-corpus number in this repo needs that caveat.
[[models]]
family = "gpt-4o-replication"
provider = "openai"
model = "gh/gpt-4o-2024-08-06"
target = 220
